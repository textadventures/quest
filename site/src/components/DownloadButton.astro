---
// Client-side "which installer does this visitor want" widget for
// questviva.com's /download page. Sibling implementation:
// src/AppShell/src/lib/download-links.ts in the quest repo (play.questviva.com's
// Play tab) — same detect+fetch+match rules, duplicated rather than shared
// since these are separate build pipelines (Astro vs. SvelteKit) with no
// shared package between them.
//
// beta.questviva.com documents the next release, so it offers the newest
// prerelease rather than GitHub's "latest" (which is always the newest stable
// release). See "Docs site" in docs/release-channels.md.
import { betaSite } from "../channel.mjs";

const fallbackUrl = betaSite
    ? "https://github.com/textadventures/quest/releases"
    : "https://github.com/textadventures/quest/releases/latest";
---

<div id="download-widget" class="download-widget" data-beta={betaSite ? "true" : undefined}>
    <a class="download-fallback-link" href={fallbackUrl}>
        All downloads (GitHub Releases)
    </a>
</div>

<script>
    const LATEST_RELEASE_API_URL = "https://api.github.com/repos/textadventures/quest/releases/latest";
    const RELEASES_API_URL = "https://api.github.com/repos/textadventures/quest/releases?per_page=30";
    // Stable releases go to the Microsoft Store too (see "Microsoft Store" in
    // docs/electron-desktop-app.md in the quest repo). The Store signs the
    // package, so a Store install gets no SmartScreen warning, which the unsigned
    // NSIS installer always does. The web listing rather than an
    // ms-windows-store: link, so it works from any browser and offers to open the
    // Store app itself.
    const MICROSOFT_STORE_URL = "https://apps.microsoft.com/detail/9N3N7KDB2TPM";

    interface ReleaseAsset {
        name: string;
        browser_download_url: string;
    }
    interface ReleaseResponse {
        tag_name: string;
        html_url: string;
        published_at: string;
        prerelease: boolean;
        draft: boolean;
        assets: ReleaseAsset[];
    }

    async function fetchJson<T>(url: string): Promise<T | null> {
        try {
            const response = await fetch(url);
            if (!response.ok) return null;
            return (await response.json()) as T;
        } catch {
            return null;
        }
    }

    // The stable site wants GitHub's "latest" release, which is never a
    // prerelease. The beta site wants the newest prerelease: the releases list
    // is newest first, and drafts (a release still waiting for its installers,
    // see finalize-release.yml) only show up for authenticated callers anyway.
    // If no prerelease is in the first page, fall back to the stable release.
    async function fetchRelease(beta: boolean): Promise<ReleaseResponse | null> {
        if (beta) {
            const releases = await fetchJson<ReleaseResponse[]>(RELEASES_API_URL);
            const prerelease = releases?.find((r) => r.prerelease && !r.draft);
            if (prerelease) return prerelease;
        }
        return fetchJson<ReleaseResponse>(LATEST_RELEASE_API_URL);
    }

    // Uses the visitor's own browser locale (undefined locale arg) rather
    // than a fixed format, so e.g. UK visitors see "19 Jul 2026" instead of
    // US ordering.
    function formatReleaseDate(iso: string): string | null {
        const date = new Date(iso);
        if (Number.isNaN(date.getTime())) return null;
        return date.toLocaleDateString(undefined, { year: "numeric", month: "short", day: "numeric" });
    }

    function detectOs(): "Windows" | "Mac" | "Linux" | null {
        const ua = navigator.userAgent;
        if (/Windows/.test(ua)) return "Windows";
        if (/Mac OS X|Macintosh/.test(ua)) return "Mac";
        if (/Linux/.test(ua)) return "Linux";
        return null;
    }

    // Extension-based, not exact filename — see download-links.ts's sibling
    // comment for why. wantArm64 undefined means "don't care" — needed for
    // Mac, whose only build is arm64 (so its .dmg filename always contains
    // "arm64"). Linux itself defaults to the x64 .deb (best desktop
    // integration, see docs/electron-desktop-app.md in the quest repo) since
    // arch can't be reliably sniffed from a browser.
    function findAsset(assets: ReleaseAsset[], extension: string, wantArm64?: boolean): ReleaseAsset | null {
        return (
            assets.find(
                (a) =>
                    a.name.toLowerCase().endsWith(extension) &&
                    (wantArm64 === undefined || a.name.toLowerCase().includes("arm64") === wantArm64),
            ) ?? null
        );
    }

    function makeLink(text: string, url: string, className: string): HTMLAnchorElement {
        const a = document.createElement("a");
        a.className = className;
        a.href = url;
        a.textContent = text;
        return a;
    }

    async function render() {
        const container = document.getElementById("download-widget");
        if (!container) return;
        const detected = detectOs();

        const beta = container.dataset.beta === "true";
        const fallbackUrl = container.querySelector("a")?.href ?? "https://github.com/textadventures/quest/releases";
        const release = await fetchRelease(beta);
        if (!release) return; // keep the static fallback link

        // Linux gets two candidates, not one — .deb and AppImage are both
        // valid choices (a release can also ship only one of the two;
        // electron-publish.yml's three OS legs run independently), so both
        // are listed for a Linux visitor to pick between rather than
        // silently dropping whichever one this widget didn't prefer. Order
        // matters: .deb listed first so it's the one picked as the
        // primary/"Download for Linux" button when both exist (best desktop
        // integration, see docs/electron-desktop-app.md in the quest repo).
        // Betas aren't in the Store, so a prerelease offers only the installer.
        const storeAsset = { name: "Microsoft Store", browser_download_url: MICROSOFT_STORE_URL };
        const windows = release.prerelease
            ? [{ os: "Windows", label: "Windows", asset: findAsset(release.assets, ".exe") }]
            : [
                  { os: "Windows", label: "Windows (Microsoft Store)", asset: storeAsset },
                  { os: "Windows", label: "Windows (installer)", asset: findAsset(release.assets, ".exe") },
              ];
        const candidates = [
            ...windows,
            { os: "Mac", label: "Mac (Apple Silicon)", asset: findAsset(release.assets, ".dmg") },
            { os: "Linux", label: "Linux (.deb)", asset: findAsset(release.assets, ".deb", false) },
            { os: "Linux", label: "Linux (.AppImage)", asset: findAsset(release.assets, ".appimage", false) },
        ];

        const primary = detected ? candidates.find((c) => c.os === detected && c.asset) : undefined;
        const others = candidates.filter((c) => c !== primary && c.asset);

        const nodes: HTMLElement[] = [];
        const releaseDate = formatReleaseDate(release.published_at);
        const versionText = document.createElement("p");
        versionText.className = "download-version";
        versionText.textContent = releaseDate ? `${release.tag_name} · released ${releaseDate}` : release.tag_name;
        nodes.push(versionText);

        if (primary?.asset) {
            nodes.push(makeLink(`Download for ${primary.label}`, primary.asset.browser_download_url, "download-primary-link"));
        }
        for (const other of others) {
            if (!other.asset) continue;
            nodes.push(makeLink(other.label, other.asset.browser_download_url, "download-secondary-link"));
        }
        // The beta site links to this prerelease's own page, since GitHub's
        // releases/latest is always the stable one.
        const allDownloadsUrl = beta && release.html_url ? release.html_url : fallbackUrl;
        nodes.push(makeLink("All downloads", allDownloadsUrl, "download-fallback-link"));

        container.replaceChildren(...nodes);
    }

    render();
</script>

<style is:global>
    /* Not scoped: Astro's per-component style scoping tags a build-time hash
       class onto elements present in this template, but the actual download
       links are created at runtime by the <script> above (render()/makeLink())
       — they'd never get that hash class, so a scoped :where(.astro-XXXX)
       selector would silently never match them. */
    .download-widget {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        margin-block: 1.5rem;
    }

    .download-version {
        font-size: 0.875rem;
        color: var(--sl-color-gray-3);
        margin: 0;
    }

    .download-primary-link {
        display: inline-block;
        padding: 0.75rem 1.5rem;
        border-radius: 0.5rem;
        background: var(--sl-color-accent);
        color: var(--sl-color-black);
        font-weight: 600;
        text-decoration: none;
    }

    .download-secondary-link,
    .download-fallback-link {
        font-size: 0.875rem;
        color: var(--sl-color-gray-3);
    }
</style>
