<library>
  <editor name="_GameEditor">
    <appliesto>game</appliesto>
    <tab>
      <caption>[EditorGameSetup]</caption>
      <helpurl>/publishing/game-details/</helpurl>

      <control>
        <controltype>textbox</controltype>
        <caption>[EditorGameGamename]</caption>
        <attribute>gamename</attribute>
      </control>

      <control>
        <controltype>textbox</controltype>
        <caption>[EditorGameSubtitle]</caption>
        <attribute>subtitle</attribute>
      </control>

      <control>
        <controltype>textbox</controltype>
        <caption>[EditorGameAuthor]</caption>
        <attribute>author</attribute>
      </control>

      <control>
        <controltype>checkbox</controltype>
        <caption>[EditorGameDisplaytitle]</caption>
        <attribute>showtitle</attribute>
      </control>

      <control>
        <controltype>textbox</controltype>
        <caption>[EditorGameVersion]</caption>
        <attribute>version</attribute>
        <width>120</width>
      </control>

      <control>
        <controltype>number</controltype>
        <caption>[EditorGameVersionCode]</caption>
        <attribute>versioncode</attribute>
        <width>80</width>
        <minimum>0</minimum>
        <samerow/>
      </control>

      <control>
        <controltype>label</controltype>
        <caption>[EditorGameTheGameIDbelow]</caption>
        <advanced/>
      </control>

      <control>
        <controltype>gameid</controltype>
        <caption>[EditorGameGameID]</caption>
        <attribute>gameid</attribute>
        <advanced/>
      </control>

      <control>
        <controltype>dropdown</controltype>
        <caption>[EditorGameCategory]</caption>
        <attribute>category</attribute>
        <validvalues type="simplestringlist">;Comedy;Educational;Fantasy;Historical;Horror;Mystery;Puzzle;Romance;RPG;Sci-Fi;Seasonal;Simulation;Slice of Life;Surreal;Adult</validvalues>
        <freetext/>
      </control>

      <control>
        <controltype>textbox</controltype>
        <caption>[EditorGameYearofrelease]</caption>
        <attribute>firstpublished</attribute>
      </control>

      <control>
        <controltype>file</controltype>
        <caption>[EditorGameCoverart]</caption>
        <attribute>cover</attribute>
        <source>[EditorImageFormats]</source>
      </control>

      <control>
        <controltype>label</controltype>
        <caption>[EditorGameRecommended]</caption>
      </control>

      <control>
        <controltype>richtext</controltype>
        <caption>[EditorGameDescription]</caption>
        <attribute>description</attribute>
        <notextprocessor/>
        <expand/>
      </control>

    </tab>

    <tab>
      <caption>[EditorGameFeatures]</caption>
      <helpurl>/howto/objects/features/#game-features</helpurl>

      <control>
        <controltype>checkbox</controltype>
        <caption>[EditorGameScore]</caption>
        <attribute>showscore</attribute>
      </control>

      <control>
        <controltype>checkbox</controltype>
        <caption>[EditorGameHealth]</caption>
        <attribute>showhealth</attribute>
      </control>

      <control>
        <controltype>checkbox</controltype>
        <caption>[EditorGameMoney]</caption>
        <attribute>showmoney</attribute>
      </control>

      <control>
        <controltype>checkbox</controltype>
        <caption>[EditorGameInventorylimits]</caption>
        <attribute>feature_limitinventory</attribute>
      </control>

      <control>
        <controltype>checkbox</controltype>
        <caption>[EditorGameLightnessand]</caption>
        <attribute>feature_lightdark</attribute>
      </control>

      <control>
        <controltype>checkbox</controltype>
        <caption>[EditorGameAsk/Tellplayers]</caption>
        <attribute>feature_asktell</attribute>
      </control>

      <control>
        <controltype>checkbox</controltype>
        <caption>[EditorGameAnnotations]</caption>
        <attribute>feature_annotations</attribute>
      </control>

      <control>
        <controltype>checkbox</controltype>
        <caption>[EditorGameAdvancedWearables]</caption>
        <attribute>feature_advancedwearables</attribute>
      </control>

      <control>
        <controltype>checkbox</controltype>
        <caption>[EditorGameAdvancedScripts]</caption>
        <attribute>feature_advancedscripts</attribute>
      </control>

      <control>
        <controltype>checkbox</controltype>
        <caption>[EditorGameInroomdescriptions]</caption>
        <attribute>appendobjectdescription</attribute>
      </control>

      <control>
        <controltype>checkbox</controltype>
        <caption>[EditorGameMultipleCommands]</caption>
        <attribute>multiplecommands</attribute>
      </control>

    </tab>

    <tab>
      <caption>[EditorGameAppearance]</caption>
      <!-- How the game looks. Options only one interface uses are shown only for it (classicinterface), and retired options only in a game that has already set them (alsodisplayifset). -->
      <!-- Changes show in a running Preview straight away (InitInterface reads these) -->
      <liveinterface/>
      <helpurl>/customise/look-and-feel/#the-appearance-tab</helpurl>

      <control>
        <caption>[EditorGameTheme]</caption>
        <controltype>dropdowntypes</controltype>
        <types>*=[TypeThemeStandard]; theme_parchment=[TypeThemeParchment]; theme_noir=[TypeThemeNoir]; theme_storybook=[TypeThemeStorybook]; theme_novella=[TypeThemeNovella]; theme_typewriter=[TypeThemeTypewriter]; theme_midnight=[TypeThemeMidnight]; theme_terminal=[TypeThemeTerminal]; theme_retro=[TypeThemeRetro]; theme_hotdogstand=[TypeThemeHotDog]</types>
        <!-- Retired themes: offered only to a game that already has one, so it can be seen and changed -->
        <hiddentypes type="simplestringlist">theme_hotdogstand</hiddentypes>
        <!-- Each theme is drawn as a little page in its colours and font (ThemePicker.svelte) -->
        <previews/>
        <!-- Choosing a theme, or its Reset button, clears the game's own value for anything a theme sets and for the rest of the look below, so the theme isn't hidden by options chosen under another. Images, the stylesheet and link underlining are the author's own and are kept. -->
        <resetoverrides/>
        <resetattributes type="simplestringlist">defaultfont;defaultwebfont;defaultfontsize;defaultforeground;interfacefont;accentcolour;defaultlinkforeground;defaultbackground;darkbackground;darkforeground;darklinkforeground;darkaccentcolour;marginscolour;darkmarginscolour;darkbordercolour;darkcustomlocationcolour;darkcustomlocationtextcolour;darkcustomlocationbordercolour;colourblend;colourblendtop;colourblendbottom;bordercolour;panestheme;customlocationcolour;customlocationtextcolour;customlocationbordercolour;borderlesscursor;commandcursor;shadowbox;menufont;menufontsize;menubackground;menuforeground;menuhoverbackground;menuhoverforeground</resetattributes>
      </control>

      <control>
        <controltype>title</controltype>
        <caption>[EditorGameFont]</caption>
      </control>

      <control>
        <controltype>dropdown</controltype>
        <caption>[EditorGameBasefont]</caption>
        <attribute>defaultfont</attribute>
        <source>basefonts</source>
        <freetext/>
      </control>

      <control>
        <controltype>dropdown</controltype>
        <caption>[EditorGameWebfont]</caption>
        <attribute>defaultwebfont</attribute>
        <source>webfonts</source>
        <freetext/>
      </control>

      <control>
        <controltype>label</controltype>
        <caption>[EditorGameWebfontHelp]</caption>
      </control>

      <control>
        <controltype>label</controltype>
        <caption>[EditorGameBrowseavailable]</caption>
        <href>https://fonts.google.com/</href>
      </control>

      <control>
        <controltype>number</controltype>
        <caption>[EditorGameFontsize]</caption>
        <attribute>defaultfontsize</attribute>
      </control>

      <control>
        <controltype>dropdown</controltype>
        <caption>[EditorGameInterfacefont]</caption>
        <attribute>interfacefont</attribute>
        <source>basefonts</source>
        <freetext/>
        <onlydisplayif>not GetBoolean(game, "classicinterface")</onlydisplayif>
      </control>

      <control>
        <controltype>label</controltype>
        <caption>[EditorGameInterfacefontHelp]</caption>
        <onlydisplayif>not GetBoolean(game, "classicinterface")</onlydisplayif>
      </control>

      <control>
        <controltype>title</controltype>
        <caption>[EditorGameColoursCaption]</caption>
      </control>

      <!-- Sample text in the game's font and colours, as the v2 player shows it in light mode and dark mode (AppearancePreview.svelte) -->
      <control>
        <controltype>appearancepreview</controltype>
        <onlydisplayif>not GetBoolean(game, "classicinterface")</onlydisplayif>
      </control>

      <control>
        <controltype>label</controltype>
        <caption>[EditorGameColoursHelp]</caption>
      </control>

      <!-- Page, text, link, accent, margin and border colours: each light one names its dark mode one (<darkattribute>), so the editor shows them as one table with Light and Dark columns. The dark controls keep their own captions, visibility and nullable hints, and are left out of the table where they are hidden. -->
      <control>
        <controltype>colour</controltype>
        <darkattribute>darkbackground</darkattribute>
        <caption>[EditorGameBackgroundColour]</caption>
        <attribute>defaultbackground</attribute>
        <validvalues type="simplestringlist">[HTMLColorNames]</validvalues>
        <playertheme/>
        <nullable/>
      </control>

      <control>
        <controltype>colour</controltype>
        <caption>[EditorGameDarkBackgroundColour]</caption>
        <attribute>darkbackground</attribute>
        <validvalues type="simplestringlist">[HTMLColorNames]</validvalues>
        <nullable/>
        <onlydisplayif>not GetBoolean(game, "classicinterface")</onlydisplayif>
      </control>

      <control>
        <controltype>colour</controltype>
        <darkattribute>darkforeground</darkattribute>
        <caption>[EditorGameForeground]</caption>
        <attribute>defaultforeground</attribute>
        <validvalues type="simplestringlist">[HTMLColorNames]</validvalues>
        <playertheme/>
        <nullable/>
      </control>

      <control>
        <controltype>colour</controltype>
        <caption>[EditorGameDarkForeground]</caption>
        <attribute>darkforeground</attribute>
        <validvalues type="simplestringlist">[HTMLColorNames]</validvalues>
        <playertheme/>
        <nullable/>
        <onlydisplayif>not GetBoolean(game, "classicinterface") and HasString(game, "darkbackground")</onlydisplayif>
      </control>

      <control>
        <controltype>colour</controltype>
        <darkattribute>darklinkforeground</darkattribute>
        <caption>[EditorGameLinkcolour]</caption>
        <attribute>defaultlinkforeground</attribute>
        <validvalues type="simplestringlist">[HTMLColorNames]</validvalues>
        <playertheme/>
        <nullable/>
        <onlydisplayif>game.enablehyperlinks</onlydisplayif>
      </control>

      <control>
        <controltype>colour</controltype>
        <caption>[EditorGameDarkLinkcolour]</caption>
        <attribute>darklinkforeground</attribute>
        <validvalues type="simplestringlist">[HTMLColorNames]</validvalues>
        <playertheme/>
        <nullable/>
        <onlydisplayif>not GetBoolean(game, "classicinterface") and HasString(game, "darkbackground") and game.enablehyperlinks</onlydisplayif>
      </control>

      <control>
        <controltype>colour</controltype>
        <darkattribute>darkaccentcolour</darkattribute>
        <caption>[EditorGameAccentColour]</caption>
        <attribute>accentcolour</attribute>
        <validvalues type="simplestringlist">[HTMLColorNames]</validvalues>
        <onlydisplayif>not GetBoolean(game, "classicinterface")</onlydisplayif>
      </control>

      <control>
        <controltype>colour</controltype>
        <caption>[EditorGameDarkAccentColour]</caption>
        <attribute>darkaccentcolour</attribute>
        <validvalues type="simplestringlist">[HTMLColorNames]</validvalues>
        <nullable/>
        <onlydisplayif>not GetBoolean(game, "classicinterface") and HasString(game, "darkbackground")</onlydisplayif>
      </control>

      <control>
        <controltype>colour</controltype>
        <darkattribute>darkmarginscolour</darkattribute>
        <caption>[EditorGameMarginColour]</caption>
        <attribute>marginscolour</attribute>
        <validvalues type="simplestringlist">[HTMLColorNames]</validvalues>
        <onlydisplayif>not game.colourblend</onlydisplayif>
      </control>

      <control>
        <controltype>colour</controltype>
        <caption>[EditorGameDarkMarginColour]</caption>
        <attribute>darkmarginscolour</attribute>
        <validvalues type="simplestringlist">[HTMLColorNames]</validvalues>
        <nullable/>
        <onlydisplayif>not GetBoolean(game, "classicinterface") and HasString(game, "darkbackground") and not game.colourblend</onlydisplayif>
      </control>

      <control>
        <controltype>colour</controltype>
        <darkattribute>darkbordercolour</darkattribute>
        <caption>[EditorGameBorderColour]</caption>
        <attribute>bordercolour</attribute>
        <validvalues type="simplestringlist">[HTMLColorNames]</validvalues>
        <onlydisplayif>game.showborder</onlydisplayif>
      </control>

      <control>
        <controltype>colour</controltype>
        <caption>[EditorGameDarkBorderColour]</caption>
        <attribute>darkbordercolour</attribute>
        <validvalues type="simplestringlist">[HTMLColorNames]</validvalues>
        <nullable/>
        <onlydisplayif>not GetBoolean(game, "classicinterface") and HasString(game, "darkbackground") and game.showborder</onlydisplayif>
      </control>

      <control>
        <controltype>label</controltype>
        <caption>[EditorGameDarkColoursHelp]</caption>
        <onlydisplayif>not GetBoolean(game, "classicinterface")</onlydisplayif>
      </control>

      <control>
        <controltype>label</controltype>
        <caption>[EditorGameAccentColourHelp]</caption>
        <onlydisplayif>not GetBoolean(game, "classicinterface")</onlydisplayif>
      </control>

      <control>
        <controltype>checkbox</controltype>
        <caption>[EditorGameUnderlinehyperlinks]</caption>
        <attribute>underlinehyperlinks</attribute>
        <onlydisplayif>game.enablehyperlinks</onlydisplayif>
      </control>

      <control>
        <controltype>file</controltype>
        <caption>[EditorGameBackground2]</caption>
        <attribute>backgroundimage</attribute>
        <source>[EditorImageFormats]</source>
        <onlydisplayif>not game.colourblend</onlydisplayif>
      </control>

      <control>
        <controltype>checkbox</controltype>
        <attribute>setbackgroundopacity</attribute>
        <caption>[EditorGameSetbackground]</caption>
        <onlydisplayif>false</onlydisplayif>
        <alsodisplayifset>setbackgroundopacity</alsodisplayifset>
      </control>

      <control>
        <controltype>numberdouble</controltype>
        <attribute>backgroundopacity</attribute>
        <caption>[EditorGameOpacity]</caption>
        <minimum type="double">0.0</minimum>
        <maximum type="double">1.0</maximum>
        <increment type="double">0.1</increment>
        <onlydisplayif>game.setbackgroundopacity</onlydisplayif>
      </control>

      <control>
        <controltype>checkbox</controltype>
        <attribute>colourblend</attribute>
        <caption>[EditorGameColourBlend]</caption>
        <onlydisplayif>false</onlydisplayif>
        <alsodisplayifset>colourblend</alsodisplayifset>
      </control>

      <control>
        <controltype>colour</controltype>
        <caption>[EditorGameColourBlendTop]</caption>
        <attribute>colourblendtop</attribute>
        <validvalues type="simplestringlist">[HTMLColorNames]</validvalues>
        <onlydisplayif>game.colourblend</onlydisplayif>
      </control>

      <control>
        <controltype>colour</controltype>
        <caption>[EditorGameColourBlendBottom]</caption>
        <attribute>colourblendbottom</attribute>
        <validvalues type="simplestringlist">[HTMLColorNames]</validvalues>
        <onlydisplayif>game.colourblend</onlydisplayif>
      </control>

      <control>
        <controltype>dropdown</controltype>
        <caption>[EditorGamePanesTheme]</caption>
        <attribute>panestheme</attribute>
        <validvalues type="simplestringlist">Classic;Midnight;Nature;Vanilla;Black;Blood;Tranquil;Parchment</validvalues>
        <onlydisplayif>game.showpanes and GetBoolean(game, "classicinterface")</onlydisplayif>
      </control>

      <control>
        <controltype>title</controltype>
        <caption>[EditorGameLocationCaption]</caption>
        <onlydisplayif>game.showlocation</onlydisplayif>
      </control>

      <control>
        <controltype>checkbox</controltype>
        <caption>[EditorGameClassiclocation]</caption>
        <attribute>classiclocation</attribute>
        <onlydisplayif>game.showlocation and GetBoolean(game, "classicinterface")</onlydisplayif>
      </control>

      <control>
        <controltype>colour</controltype>
        <darkattribute>darkcustomlocationcolour</darkattribute>
        <caption>[EditorGameLocationColour]</caption>
        <attribute>customlocationcolour</attribute>
        <validvalues type="simplestringlist">[HTMLColorNames]</validvalues>
        <onlydisplayif>game.showlocation and (not GetBoolean(game, "classicinterface") or not game.classiclocation)</onlydisplayif>
      </control>

      <control>
        <controltype>colour</controltype>
        <caption>[EditorGameDarkLocationColour]</caption>
        <attribute>darkcustomlocationcolour</attribute>
        <validvalues type="simplestringlist">[HTMLColorNames]</validvalues>
        <nullable/>
        <onlydisplayif>game.showlocation and not GetBoolean(game, "classicinterface") and HasString(game, "darkbackground")</onlydisplayif>
      </control>

      <control>
        <controltype>colour</controltype>
        <darkattribute>darkcustomlocationtextcolour</darkattribute>
        <caption>[EditorGameLocationTextColour]</caption>
        <attribute>customlocationtextcolour</attribute>
        <validvalues type="simplestringlist">[HTMLColorNames]</validvalues>
        <onlydisplayif>game.showlocation and (not GetBoolean(game, "classicinterface") or not game.classiclocation)</onlydisplayif>
      </control>

      <control>
        <controltype>colour</controltype>
        <caption>[EditorGameDarkLocationTextColour]</caption>
        <attribute>darkcustomlocationtextcolour</attribute>
        <validvalues type="simplestringlist">[HTMLColorNames]</validvalues>
        <nullable/>
        <onlydisplayif>game.showlocation and not GetBoolean(game, "classicinterface") and HasString(game, "darkbackground")</onlydisplayif>
      </control>

      <control>
        <controltype>colour</controltype>
        <darkattribute>darkcustomlocationbordercolour</darkattribute>
        <caption>[EditorGameLocationBorderColour]</caption>
        <attribute>customlocationbordercolour</attribute>
        <validvalues type="simplestringlist">[HTMLColorNames]</validvalues>
        <onlydisplayif>game.showlocation and (not GetBoolean(game, "classicinterface") or not game.classiclocation)</onlydisplayif>
      </control>

      <control>
        <controltype>colour</controltype>
        <caption>[EditorGameDarkLocationBorderColour]</caption>
        <attribute>darkcustomlocationbordercolour</attribute>
        <validvalues type="simplestringlist">[HTMLColorNames]</validvalues>
        <nullable/>
        <onlydisplayif>game.showlocation and not GetBoolean(game, "classicinterface") and HasString(game, "darkbackground")</onlydisplayif>
      </control>

      <control>
        <controltype>file</controltype>
        <caption>[EditorGameLocationBarBg]</caption>
        <attribute>locationbarimage</attribute>
        <source>[EditorImageFormats]</source>
        <onlydisplayif>game.showlocation and (not GetBoolean(game, "classicinterface") or not game.classiclocation)</onlydisplayif>
      </control>

      <control>
        <controltype>title</controltype>
        <caption>[EditorGameCommandBarCaption]</caption>
        <onlydisplayif>game.showcommandbar</onlydisplayif>
      </control>

      <control>
        <controltype>checkbox</controltype>
        <caption>[EditorGameBorderlessCommand]</caption>
        <attribute>borderlesscursor</attribute>
        <onlydisplayif>game.showcommandbar</onlydisplayif>
      </control>

      <control>
        <controltype>textbox</controltype>
        <caption>[EditorGameCommandCursor]</caption>
        <attribute>commandcursor</attribute>
        <onlydisplayif>game.showcommandbar and game.borderlesscursor</onlydisplayif>
      </control>

      <control>
        <controltype>checkbox</controltype>
        <caption>[EditorGameShadowBox]</caption>
        <attribute>shadowbox</attribute>
        <onlydisplayif>game.showcommandbar and not game.borderlesscursor and false</onlydisplayif>
        <alsodisplayifset>shadowbox</alsodisplayifset>
      </control>

      <control>
        <controltype>title</controltype>
        <caption>[EditorGameVerbMenus]</caption>
        <onlydisplayif>game.enablehyperlinks</onlydisplayif>
      </control>

      <control>
        <controltype>dropdown</controltype>
        <caption>[EditorGameMenuFont]</caption>
        <attribute>menufont</attribute>
        <source>basefonts</source>
        <freetext/>
        <nullable/>
        <onlydisplayif>game.enablehyperlinks</onlydisplayif>
      </control>

      <control>
        <controltype>number</controltype>
        <caption>[EditorGameFontsize]</caption>
        <attribute>menufontsize</attribute>
        <onlydisplayif>game.enablehyperlinks</onlydisplayif>
      </control>

      <control>
        <controltype>label</controltype>
        <caption>[EditorGameMenuFontHelp]</caption>
        <onlydisplayif>game.enablehyperlinks</onlydisplayif>
      </control>

      <control>
        <controltype>colour</controltype>
        <caption>[EditorGameBackground]</caption>
        <attribute>menubackground</attribute>
        <validvalues type="simplestringlist">[HTMLColorNames]</validvalues>
        <onlydisplayif>game.enablehyperlinks and false</onlydisplayif>
        <alsodisplayifset>menubackground</alsodisplayifset>
      </control>

      <control>
        <controltype>colour</controltype>
        <caption>[EditorGameForeground]</caption>
        <attribute>menuforeground</attribute>
        <validvalues type="simplestringlist">[HTMLColorNames]</validvalues>
        <onlydisplayif>game.enablehyperlinks and false</onlydisplayif>
        <alsodisplayifset>menuforeground</alsodisplayifset>
      </control>

      <control>
        <controltype>colour</controltype>
        <caption>[EditorGameHoverbackground]</caption>
        <attribute>menuhoverbackground</attribute>
        <validvalues type="simplestringlist">[HTMLColorNames]</validvalues>
        <onlydisplayif>game.enablehyperlinks and false</onlydisplayif>
        <alsodisplayifset>menuhoverbackground</alsodisplayifset>
      </control>

      <control>
        <controltype>colour</controltype>
        <caption>[EditorGameHoverforeground]</caption>
        <attribute>menuhoverforeground</attribute>
        <validvalues type="simplestringlist">[HTMLColorNames]</validvalues>
        <onlydisplayif>game.enablehyperlinks and false</onlydisplayif>
        <alsodisplayifset>menuhoverforeground</alsodisplayifset>
      </control>

      <control>
        <controltype>title</controltype>
        <caption>[EditorGameLayout]</caption>
        <advanced/>
      </control>

      <control>
        <controltype>checkbox</controltype>
        <caption>[EditorGameSetacustom]</caption>
        <attribute>setcustomwidth</attribute>
        <advanced/>
      </control>

      <control>
        <controltype>number</controltype>
        <attribute>customwidth</attribute>
        <caption>[EditorGameWidth]</caption>
        <minimum>100</minimum>
        <onlydisplayif>game.setcustomwidth</onlydisplayif>
        <advanced/>
      </control>

      <control>
        <controltype>checkbox</controltype>
        <caption>[EditorGameSetcustompadding]</caption>
        <attribute>setcustompadding</attribute>
        <advanced/>
      </control>

      <control>
        <controltype>number</controltype>
        <attribute>custompaddingtop</attribute>
        <caption>[EditorGameTop]</caption>
        <minimum>0</minimum>
        <onlydisplayif>game.setcustompadding</onlydisplayif>
        <advanced/>
      </control>

      <control>
        <controltype>number</controltype>
        <attribute>custompaddingbottom</attribute>
        <caption>[EditorGameBottom]</caption>
        <minimum>0</minimum>
        <onlydisplayif>game.setcustompadding</onlydisplayif>
        <advanced/>
      </control>

      <control>
        <controltype>number</controltype>
        <attribute>custompaddingleft</attribute>
        <caption>[EditorGameLeft]</caption>
        <minimum>0</minimum>
        <onlydisplayif>game.setcustompadding</onlydisplayif>
        <advanced/>
      </control>

      <control>
        <controltype>number</controltype>
        <attribute>custompaddingright</attribute>
        <caption>[EditorGameRight]</caption>
        <minimum>0</minimum>
        <onlydisplayif>game.setcustompadding</onlydisplayif>
        <advanced/>
      </control>

      <control>
        <controltype>title</controltype>
        <caption>[EditorGameStylesheetTitle]</caption>
        <advanced/>
      </control>

      <control>
        <controltype>label</controltype>
        <caption>[EditorGameStylesheetHelp]</caption>
        <advanced/>
      </control>

      <control>
        <controltype>csseditor</controltype>
        <caption>[EditorGameStylesheet]</caption>
        <attribute>stylesheet</attribute>
        <advanced/>
      </control>

    </tab>

    <tab>
      <caption>[EditorGameInterface]</caption>
      <!-- What's on screen, and how it behaves. Options only one interface uses are shown only for it (classicinterface). -->
      <!-- Changes show in a running Preview straight away (InitInterface reads these) -->
      <liveinterface/>
      <helpurl>/customise/look-and-feel/#the-interface-tab</helpurl>

      <!-- A miniature of the v2 player, wide and on a phone, with the parts this tab turns on where the layout puts them (InterfacePreview.svelte) -->
      <control>
        <controltype>interfacepreview</controltype>
        <onlydisplayif>not GetBoolean(game, "classicinterface")</onlydisplayif>
      </control>

      <control>
        <controltype>title</controltype>
        <caption>[EditorGameOnScreenCaption]</caption>
      </control>

      <control>
        <controltype>checkbox</controltype>
        <caption>[EditorGameShowlocation]</caption>
        <attribute>showlocation</attribute>
      </control>

      <control>
        <controltype>checkbox</controltype>
        <caption>[EditorGameShowborder]</caption>
        <attribute>showborder</attribute>
      </control>

      <control>
        <controltype>checkbox</controltype>
        <caption>[EditorGameShowcommand]</caption>
        <attribute>showcommandbar</attribute>
      </control>

      <control>
        <controltype>textbox</controltype>
        <caption>[EditorGameCommandPlaceholder]</caption>
        <attribute>commandplaceholder</attribute>
        <onlydisplayif>game.showcommandbar</onlydisplayif>
      </control>

      <control>
        <controltype>checkbox</controltype>
        <caption>[EditorGamePictureframe]</caption>
        <attribute>feature_pictureframe</attribute>
      </control>

      <control>
        <controltype>label</controltype>
        <caption>[EditorGamePictureframeHelp]</caption>
        <onlydisplayif>game.feature_pictureframe</onlydisplayif>
      </control>

      <control>
        <controltype>checkbox</controltype>
        <caption>[EditorGameClearpicture]</caption>
        <attribute>clearframe</attribute>
        <onlydisplayif>game.feature_pictureframe</onlydisplayif>
      </control>

      <control>
        <controltype>title</controltype>
        <caption>[EditorGamePanesCaption]</caption>
      </control>

      <control>
        <controltype>checkbox</controltype>
        <caption>[EditorGameShowpanesInventory,]</caption>
        <attribute>showpanes</attribute>
      </control>

      <control>
        <controltype>dropdown</controltype>
        <caption>[EditorGameLayoutPreset]</caption>
        <attribute>layoutpreset</attribute>
        <validvalues type="simplestringdictionary">=[EditorGameLayoutSidepanes]; bottombar=[EditorGameLayoutBottombar]; nopanes=[EditorGameLayoutNopanes]</validvalues>
        <onlydisplayif>game.showpanes and not GetBoolean(game, "classicinterface")</onlydisplayif>
      </control>

      <control>
        <controltype>dropdown</controltype>
        <caption>[EditorGameNarrowLayoutPreset]</caption>
        <attribute>narrowlayoutpreset</attribute>
        <validvalues type="simplestringdictionary">=[EditorGameLayoutSame]; sidepanes=[EditorGameLayoutDrawer]; bottombar=[EditorGameLayoutBottombar]; nopanes=[EditorGameLayoutNopanes]</validvalues>
        <onlydisplayif>game.showpanes and not GetBoolean(game, "classicinterface")</onlydisplayif>
      </control>

      <control>
        <controltype>checkbox</controltype>
        <caption>[EditorGameTurnOffCompass]</caption>
        <attribute>turnoffcompass</attribute>
        <onlydisplayif>game.showpanes</onlydisplayif>
      </control>

      <control>
        <controltype>checkbox</controltype>
        <caption>[EditorGameTurnOffInventory]</caption>
        <attribute>turnoffinventory</attribute>
        <onlydisplayif>game.showpanes</onlydisplayif>
      </control>

      <control>
        <controltype>checkbox</controltype>
        <caption>[EditorGameTurnOffPlacesAndObjects]</caption>
        <attribute>turnoffplacesandobjects</attribute>
        <onlydisplayif>game.showpanes</onlydisplayif>
      </control>

      <control>
        <controltype>checkbox</controltype>
        <caption>[EditorGameAltPaneOrder]</caption>
        <attribute>statusandcompassattop</attribute>
        <onlydisplayif>game.showpanes</onlydisplayif>
      </control>

      <control>
        <controltype>checkbox</controltype>
        <caption>[EditorGameShowCommandPane]</caption>
        <attribute>commandpane</attribute>
        <onlydisplayif>game.showpanes</onlydisplayif>
      </control>

      <control>
        <controltype>label</controltype>
        <caption>[EditorGameShowCommandPaneHelp]</caption>
        <onlydisplayif>game.showpanes and game.commandpane</onlydisplayif>
      </control>

      <control>
        <controltype>checkbox</controltype>
        <caption>[EditorGameShowCustomStatusPane]</caption>
        <attribute>customstatuspane</attribute>
        <onlydisplayif>game.showpanes</onlydisplayif>
      </control>

      <control>
        <controltype>label</controltype>
        <caption>[EditorGameShowCustomStatusPaneHelp]</caption>
        <onlydisplayif>game.showpanes and game.customstatuspane</onlydisplayif>
      </control>

      <control>
        <controltype>title</controltype>
        <caption>[EditorGameMap]</caption>
      </control>

      <control>
        <controltype>checkbox</controltype>
        <caption>[EditorGameMapadynamically]</caption>
        <attribute>gridmap</attribute>
      </control>

      <control>
        <controltype>label</controltype>
        <caption>[EditorGameMapHelp]</caption>
        <onlydisplayif>game.gridmap</onlydisplayif>
      </control>

      <control>
        <controltype>number</controltype>
        <attribute>mapscale</attribute>
        <caption>[EditorGameScale]</caption>
        <minimum>1</minimum>
        <onlydisplayif>game.gridmap</onlydisplayif>
      </control>

      <control>
        <controltype>number</controltype>
        <attribute>mapsize</attribute>
        <caption>[EditorGameHeightpixels]</caption>
        <minimum>1</minimum>
        <onlydisplayif>game.gridmap</onlydisplayif>
      </control>

      <control>
        <controltype>number</controltype>
        <attribute>mapexitwidth</attribute>
        <caption>[EditorGameExitwidth]</caption>
        <minimum>1</minimum>
        <onlydisplayif>game.gridmap</onlydisplayif>
      </control>

      <control>
        <controltype>colour</controltype>
        <caption>[EditorGameExitcolour]</caption>
        <attribute>mapexitcolour</attribute>
        <validvalues type="simplestringlist">[HTMLColorNames]</validvalues>
        <onlydisplayif>game.gridmap</onlydisplayif>
      </control>

      <control>
        <controltype>checkbox</controltype>
        <caption>[EditorGameMapinteractive]</caption>
        <attribute>mapinteractive</attribute>
        <onlydisplayif>game.gridmap</onlydisplayif>
      </control>

      <control>
        <controltype>dropdown</controltype>
        <caption>[EditorGameMapPosition]</caption>
        <attribute>mapposition</attribute>
        <validvalues type="simplestringdictionary">=[EditorGameMapPositionHeader]; panes=[EditorGameMapPositionPanes]</validvalues>
        <onlydisplayif>game.gridmap and not GetBoolean(game, "classicinterface")</onlydisplayif>
      </control>

      <control>
        <controltype>title</controltype>
        <caption>[EditorGameLinksMenusCaption]</caption>
      </control>

      <control>
        <controltype>checkbox</controltype>
        <caption>[EditorGameFeaturesHyperlinks]</caption>
        <attribute>enablehyperlinks</attribute>
      </control>

      <control>
        <controltype>checkbox</controltype>
        <caption>[EditorGameAfterusing]</caption>
        <attribute>deactivatecommandlinks</attribute>
      </control>

      <control>
        <controltype>checkbox</controltype>
        <caption>[EditorGameDoNotClearMenus]</caption>
        <attribute>donotclearmenus</attribute>
      </control>

      <control>
        <controltype>checkbox</controltype>
        <caption>[EditorGameShowMenuResponses]</caption>
        <attribute>showmenuresponses</attribute>
      </control>

      <control>
        <controltype>title</controltype>
        <caption>[EditorGameOutputCaption]</caption>
      </control>

      <control>
        <controltype>checkbox</controltype>
        <caption>[EditorGameAutoscroll]</caption>
        <attribute>autoscroll</attribute>
      </control>

      <control>
        <controltype>checkbox</controltype>
        <caption>[EditorGameContinueonclick]</caption>
        <attribute>continueonclick</attribute>
      </control>

      <control>
        <controltype>checkbox</controltype>
        <caption>[EditorGameFadepreviousoutput]</caption>
        <attribute>fadepreviousoutput</attribute>
      </control>

      <control>
        <controltype>title</controltype>
        <caption>[EditorGamePlayerInterfaceTitle]</caption>
        <advanced/>
      </control>

      <control>
        <controltype>checkbox</controltype>
        <caption>[EditorGameClassicinterface]</caption>
        <attribute>classicinterface</attribute>
        <advanced/>
      </control>

      <control>
        <controltype>label</controltype>
        <caption>[EditorGameClassicinterfaceHelp]</caption>
        <advanced/>
      </control>

      <control>
        <controltype>title</controltype>
        <caption>[EditorGameMap]</caption>
        <onlydisplayif>game.gridmap</onlydisplayif>
        <advanced/>
      </control>

      <control>
        <controltype>checkbox</controltype>
        <caption>[EditorGameRespondtogridclicks]</caption>
        <attribute>respondtogridclicks</attribute>
        <onlydisplayif>game.gridmap</onlydisplayif>
        <advanced/>
      </control>

    </tab>

    <tab>
      <caption>[EditorGameScript]</caption>
      <helpurl>/understanding/when-scripts-run/#the-game-scripts-tab</helpurl>
      <advanced/>

      <control>
        <controltype>script</controltype>
        <caption>[EditorGameStartscript]</caption>
        <attribute>start</attribute>
      </control>

      <control>
        <controltype>script</controltype>
        <caption>[EditorGameRoomscript]</caption>
        <attribute>roomenter</attribute>
      </control>

      <control>
        <caption>[EditorGameTurnscripts]</caption>
        <controltype>elementslist</controltype>
        <elementtype>object</elementtype>
        <objecttype>turnscript</objecttype>
      </control>

    </tab>

    <tab>
      <onlydisplayif>game.feature_advancedscripts</onlydisplayif>
      <caption>[EditorGameAdvancedScript]</caption>
      <helpurl>/howto/scripting/advanced-game-scripts/</helpurl>
      <advanced/>

      <control>
        <controltype>script</controltype>
        <caption>[EditorGameInitUIscript]</caption>
        <attribute>inituserinterface</attribute>
      </control>

      <control>
        <controltype>script</controltype>
        <caption>[EditorGameUnresolvedscript]</caption>
        <attribute>unresolvedcommandhandler</attribute>
      </control>

      <control>
        <controltype>script</controltype>
        <caption>[EditorGameBackdropscript]</caption>
        <attribute>scopebackdrop</attribute>
      </control>

    </tab>

    <tab>
      <caption>[EditorGameRoomDescriptions]</caption>
      <helpurl>/customise/look-and-feel/#the-room-descriptions-tab</helpurl>
      <advanced/>

      <control>
        <controltype>checkbox</controltype>
        <caption>[EditorGameAutomatically]</caption>
        <attribute>autodescription</attribute>
      </control>
      <control>
        <controltype>checkbox</controltype>
        <caption>[EditorGameShowroomdescription]</caption>
        <attribute>showdescriptiononenter</attribute>
      </control>
      <control>
        <controltype>checkbox</controltype>
        <caption>[EditorGamePutanextraNewline]</caption>
        <attribute>changeroom_newline</attribute>
        <onlydisplayif>not game.command_newline</onlydisplayif>
      </control>
      <control>
        <controltype>checkbox</controltype>
        <caption>[EditorGameDisplaycommands]</caption>
        <attribute>echocommand</attribute>
      </control>
      <control>
        <controltype>checkbox</controltype>
        <caption>[EditorGamePutanextraBeforeTurn]</caption>
        <attribute>command_newline</attribute>
      </control>
      <control>
        <controltype>checkbox</controltype>
        <caption>[EditorGameDisplayhyperlinks]</caption>
        <attribute>echohyperlinks</attribute>
        <onlydisplayif>game.enablehyperlinks and game.echocommand</onlydisplayif>
      </control>
      <control>
        <controltype>checkbox</controltype>
        <caption>[EditorGameAutomaticallyObjectList]</caption>
        <attribute>autodisplayverbs</attribute>
      </control>
      <control>
        <controltype>checkbox</controltype>
        <caption>[EditorGameClearscreenonroomenter]</caption>
        <attribute>clearscreenonroomenter</attribute>
      </control>

      <control>
        <controltype>title</controltype>
        <caption>[EditorGameRoomdescription]</caption>
        <onlydisplayif>game.autodescription</onlydisplayif>
      </control>

      <control>
        <controltype>label</controltype>
        <caption>[EditorGameUsethenumbers]</caption>
        <onlydisplayif>game.autodescription</onlydisplayif>
      </control>

      <control>
        <controltype>number</controltype>
        <attribute>autodescription_youarein</attribute>
        <caption>[EditorGameRoomname]</caption>
        <minimum>0</minimum>
        <maximum>4</maximum>
        <onlydisplayif>game.autodescription</onlydisplayif>
      </control>

      <control>
        <controltype>number</controltype>
        <attribute>autodescription_youcansee</attribute>
        <caption>[EditorGameObjectslist]</caption>
        <minimum>0</minimum>
        <maximum>4</maximum>
        <onlydisplayif>game.autodescription</onlydisplayif>
      </control>

      <control>
        <controltype>number</controltype>
        <attribute>autodescription_youcango</attribute>
        <caption>[EditorGameExitslist]</caption>
        <minimum>0</minimum>
        <maximum>4</maximum>
        <onlydisplayif>game.autodescription</onlydisplayif>
      </control>

      <control>
        <controltype>number</controltype>
        <attribute>autodescription_description</attribute>
        <caption>[EditorGameDescription]</caption>
        <minimum>0</minimum>
        <maximum>4</maximum>
        <onlydisplayif>game.autodescription</onlydisplayif>
      </control>

      <control>
        <controltype>checkbox</controltype>
        <attribute>autodescription_youarein_useprefix</attribute>
        <caption>[EditorGameUseYouAreIn]</caption>
        <onlydisplayif>game.autodescription</onlydisplayif>
      </control>

      <control>
        <controltype>checkbox</controltype>
        <attribute>autodescription_youarein_newline</attribute>
        <caption>[EditorGamePutanewline]</caption>
        <onlydisplayif>game.autodescription</onlydisplayif>
      </control>

      <control>
        <controltype>checkbox</controltype>
        <attribute>autodescription_youcansee_newline</attribute>
        <caption>[EditorGamePutanewline2]</caption>
        <onlydisplayif>game.autodescription</onlydisplayif>
      </control>

      <control>
        <controltype>checkbox</controltype>
        <attribute>autodescription_youcango_newline</attribute>
        <caption>[EditorGamePutanewline3]</caption>
        <onlydisplayif>game.autodescription</onlydisplayif>
      </control>

      <control>
        <controltype>checkbox</controltype>
        <attribute>autodescription_description_newline</attribute>
        <caption>[EditorGamePutanewline4]</caption>
        <onlydisplayif>game.autodescription</onlydisplayif>
      </control>

    </tab>

    <tab>
      <caption>[EditorGamePlayer]</caption>
      <helpurl>/howto/player/player-object/</helpurl>
      <advanced/>

      <control>
        <caption>[EditorGamePlayerobject]</caption>
        <attribute>pov</attribute>
        <controltype>objects</controltype>
        <advanced/>
      </control>

      <control>
        <onlydisplayif>game.pov = null</onlydisplayif>
        <advanced/>
        <controltype>label</controltype>
        <caption>[EditorGameIfnoplayer]</caption>
      </control>

      <control>
        <controltype>script</controltype>
        <attribute>onhealthzero</attribute>
        <onlydisplayif>game.showhealth</onlydisplayif>
        <caption>[EditorGameScripttorun]</caption>
      </control>

      <control>
        <controltype>textbox</controltype>
        <caption>[EditorGameMoneyformat]</caption>
        <attribute>moneyformat</attribute>
        <onlydisplayif>game.showmoney</onlydisplayif>
        <width>50</width>
      </control>

      <control>
        <controltype>stringdictionary</controltype>
        <caption>[EditorGamePlayerobjectStatus]</caption>
        <keyprompt>[EditorGameAttributesPleaseenter]</keyprompt>
        <valueprompt>[EditorGameAttributesPleaseenter2]</valueprompt>
        <attribute>povstatusattributes</attribute>
        <advanced/>
      </control>
    </tab>

    <tab>
      <caption>[EditorGameAttributes]</caption>
      <helpurl>/tutorial/custom-attributes/#the-attributes-tab</helpurl>
      <advanced/>

      <control>
        <controltype>stringdictionary</controltype>
        <caption>[EditorGameStatusattributes]</caption>
        <keyprompt>[EditorGameAttributesPleaseenter]</keyprompt>
        <valueprompt>[EditorGameAttributesPleaseenter2]</valueprompt>
        <attribute>statusattributes</attribute>
      </control>

      <control>
        <controltype>list</controltype>
        <caption>[EditorGamePinnedstatusattributes]</caption>
        <attribute>pinnedstatusattributes</attribute>
        <editprompt>[EditorGameAttributesPleaseenter]</editprompt>
      </control>

      <control>
        <controltype>stringdictionary</controltype>
        <caption>[EditorGameStatusattributemaximums]</caption>
        <keyprompt>[EditorGameAttributesPleaseenter]</keyprompt>
        <valueprompt>[EditorGameStatusattributemaximumsPrompt]</valueprompt>
        <attribute>statusattributemaximums</attribute>
      </control>

      <control>
        <controltype>attributes</controltype>
        <expand/>
      </control>

    </tab>

  </editor>
</library>
