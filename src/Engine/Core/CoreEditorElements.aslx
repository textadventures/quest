<library>

  <editor>
    <appliesto>_objects</appliesto>
    <tab>
      <caption>[EditorElementsObjects]</caption>

      <control>
        <controltype>elementslist</controltype>
        <elementtype>object</elementtype>
        <objecttype>object</objecttype>
        <expand/>
      </control>

    </tab>
  </editor>

  <editor>
    <appliesto>_gameCommands</appliesto>
    <tab>
      <caption>[EditorElementsCommands]</caption>

      <control>
        <controltype>elementslist</controltype>
        <elementtype>object</elementtype>
        <objecttype>command</objecttype>
        <listfilter>command</listfilter>
        <expand/>
      </control>

    </tab>
  </editor>

  <editor>
    <appliesto>_gameVerbs</appliesto>
    <tab>
      <caption>[EditorElementsVerbs]</caption>

      <control>
        <controltype>elementslist</controltype>
        <elementtype>object</elementtype>
        <objecttype>command</objecttype>
        <listfilter>verb</listfilter>
        <expand/>
      </control>

    </tab>
  </editor>

  <!-- The game's stylesheet, on a node of its own in the tree: the node's editor data is the
       game's (EditorController.StylesheetNode) -->
  <editor>
    <appliesto>_stylesheet</appliesto>
    <tab>
      <caption>[EditorGameStylesheetTitle]</caption>
      <!-- A running Preview shows a change straight away (EditorController.GetLiveInterfaceAttributes) -->
      <liveinterface/>

      <control>
        <controltype>label</controltype>
        <caption>[EditorGameStylesheetHelp]</caption>
      </control>

      <control>
        <controltype>label</controltype>
        <caption>[EditorGameStylesheetDocs]</caption>
        <href>/customise/css/</href>
      </control>

      <control>
        <controltype>csseditor</controltype>
        <caption>[EditorGameStylesheet]</caption>
        <attribute>stylesheet</attribute>
        <!-- An example, shown while the stylesheet is empty: a rule both interfaces understand -->
        <placeholder>[EditorGameStylesheetPlaceholder]</placeholder>
      </control>

    </tab>
  </editor>

  <editor>
    <appliesto>_functions</appliesto>
    <tab>
      <caption>[EditorElementsFunctions]</caption>

      <control>
        <controltype>elementslist</controltype>
        <elementtype>function</elementtype>
        <expand/>
      </control>

    </tab>
  </editor>

