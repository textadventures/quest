<library>
  <function name="TextFX_Typewriter" parameters="text, speed">
    <![CDATA[
      // The game's starting font, colour and size are passed as "", as GetCurrentTextFormat leaves
      // them out of output, so the effect's text inherits them from the UI (#2627, decision 4).
      font = GetCurrentFontFamily()
      if (font = GetUIDefault("font")) {
        font = ""
      }
      color = game.defaultforeground
      if (color = GetUIDefault("foreground")) {
        color = ""
      }
      size = ToString(game.defaultfontsize)
      if (size = GetUIDefault("fontsize")) {
        size = ""
      }
      TextFX_Typewriter_Internal (text, speed, font, color, size)
    ]]>
  </function>

  <function name="TextFX_Typewriter_Internal" parameters="text, speed, font, color, size">
    JS.QuestUI.textEffect("typewriter", text, speed, font, color, size)
  </function>

  <function name="TextFX_Unscramble" parameters="text, speed, reveal">
    <![CDATA[
      // As TextFX_Typewriter, the game's starting font, colour and size are passed as "".
      font = GetCurrentFontFamily()
      if (font = GetUIDefault("font")) {
        font = ""
      }
      color = game.defaultforeground
      if (color = GetUIDefault("foreground")) {
        color = ""
      }
      size = ToString(game.defaultfontsize)
      if (size = GetUIDefault("fontsize")) {
        size = ""
      }
      TextFX_Unscramble_Internal (text, speed, reveal, font, color, size)
    ]]>
  </function>

  <function name="TextFX_Unscramble_Internal" parameters="text, speed, reveal, font, color, size">
    JS.QuestUI.textEffect("unscramble", text, speed, reveal, font, color, size)
  </function>
</library>
