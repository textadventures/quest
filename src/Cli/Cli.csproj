<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <RootNamespace>QuestViva.Cli</RootNamespace>
        <AssemblyName>qv</AssemblyName>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>default</LangVersion>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>qv</ToolCommandName>
        <PackageId>QuestViva.Cli</PackageId>
        <Description>Command-line tools for Quest Viva: play text adventure games in the terminal, or drive them from another program or an AI agent.</Description>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
        <PackageReference Include="ModelContextProtocol" Version="2.3.0" />
        <PackageReference Include="System.CommandLine" Version="2.0.14" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="CliTests" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\PlayerCore\PlayerCore.csproj" />
    </ItemGroup>
</Project>
