<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <RootNamespace>QuestViva.Cli</RootNamespace>
        <AssemblyName>qv</AssemblyName>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>default</LangVersion>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>qv</ToolCommandName>
        <PackageId>QuestViva.Cli</PackageId>
        <!-- qv reports the repo's VERSION as its own version, however it was built. Release
             workflows pass the same value as the Version property. -->
        <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../../VERSION').Trim())</Version>
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
        <Description>Command-line tools for Quest Viva: play text adventure games in the terminal, or drive them from another program or an AI agent.</Description>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
        <PackageReference Include="ModelContextProtocol" Version="2.3.0" />
        <PackageReference Include="System.CommandLine" Version="2.0.14" />
    </ItemGroup>
    <!-- The reference, "understanding" and how-to pages of the documentation site, for qv mcp's docs tool,
         so an agent reads the docs for the version of Quest it's running. -->
    <ItemGroup>
        <EmbeddedResource Include="..\..\site\src\content\docs\reference\**\*.md"
                          LogicalName="docs/reference/%(RecursiveDir)%(Filename)%(Extension)" />
        <EmbeddedResource Include="..\..\site\src\content\docs\understanding\**\*.md"
                          LogicalName="docs/understanding/%(RecursiveDir)%(Filename)%(Extension)" />
        <EmbeddedResource Include="..\..\site\src\content\docs\howto\**\*.md"
                          LogicalName="docs/howto/%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="CliTests" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\PlayerCore\PlayerCore.csproj" />
    </ItemGroup>
</Project>
