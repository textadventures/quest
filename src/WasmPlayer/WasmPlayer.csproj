<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
        <OutputType>Exe</OutputType>
        <RootNamespace>QuestViva.WasmPlayer</RootNamespace>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Nullable>enable</Nullable>
        <LangVersion>default</LangVersion>
        <!-- Shipped via `dotnet publish -c Release`, which IL-trims the unused .NET framework out of
             the AppBundle (~190 files / 7.9 MB brotli down to ~50 / 3.3 MB); `dotnet build` never
             trims. No AOT: RunAOTCompilation likewise only applies on publish, so while it was set
             here every shipped bundle (always from `dotnet build`) still ran the interpreter, and
             really turning it on roughly doubles the download. Pass -p:RunAOTCompilation=true to
             publish an AOT build for profiling. -->
        <!-- IL2104 is the one-line summary the trimmer emits per third-party assembly with trim
             warnings - here Parlot, NCalc's parser library. All but one are in compiled-parser mode
             (Parser.Compile), which Engine only uses when the NCalc.EnableParlotParserCompilation
             AppContext switch is set, and nothing sets it; the other is NumberLiteral<T> looking up
             its numeric type's parse method, which every numeric literal in a game script exercises.
             Our own projects' trim warnings are still reported individually, and
             TreatWarningsAsErrors fails the publish on them. -->
        <NoWarn>$(NoWarn);IL2104</NoWarn>
        <!-- Release is what ships (Electron, static hosting, often offline). Shipping .pdb files
             embeds SourceLink metadata pointing at raw.githubusercontent.com, which Chrome DevTools'
             WASM debugger fetches from when attached — undesirable for an offline-capable app.
             The dotnet.js/.runtime.js source maps have the same problem, pointing at dotnet/dotnet
             on GitHub. Debug builds keep both for local dev-server debugging. -->
        <WasmDebugLevel Condition="'$(Configuration)' == 'Release'">0</WasmDebugLevel>
        <WasmEmitSourceMap Condition="'$(Configuration)' == 'Release'">false</WasmEmitSourceMap>
        <!-- Publish otherwise lists dotnet.native.js.symbols (~720 KB) in the boot manifest, which
             the runtime then fetches on every load - and without the ?v= cache key, so it would be
             served `immutable` with nothing to bust it on the next deploy. -->
        <WasmEmitSymbolMap Condition="'$(Configuration)' == 'Release'">false</WasmEmitSymbolMap>
        <!-- The WebAssembly SDK strips .NET's exception message strings by default, so a game script
             error read "Arg_KeyNotFoundWithKey, x" instead of "The given key 'x' was not present in
             the dictionary." Players and authors see these messages in the transcript. -->
        <UseSystemResourceKeys>false</UseSystemResourceKeys>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\PlayerCore\PlayerCore.csproj"/>
    </ItemGroup>

    <Import Project="..\WasmAppBundle.targets"/>

    <PropertyGroup>
        <!-- Serve wwwroot/ under its own file names, like _framework/ (WasmFingerprintAssets in
             ../WasmAppBundle.targets): cache busting is the ?v= query, not content hashes. -->
        <StaticWebAssetsFingerprintContent>false</StaticWebAssetsFingerprintContent>
    </PropertyGroup>
    <ItemGroup>
        <!-- Documentation for the vendored libraries, not something the player serves. -->
        <Content Remove="wwwroot\legacy\lib\README.md"/>
    </ItemGroup>

    <!-- Build the scoped Skeleton/Tailwind "app chrome" stylesheet (start screen, debugger,
         save-slot manager) from styles/chrome.css into wwwroot/chrome.css, and splice the curated
         icon sprite (see scripts/build-icons.mjs) into wwwroot/index.html. Both are build outputs
         (gitignored), so on a clean checkout they don't exist when the project is evaluated and
         the SDK's wwwroot/** Content glob misses them. Running before static web asset discovery
         and re-adding them here makes them static web assets either way. -->
    <Target Name="BuildChromeCss" BeforeTargets="ResolveProjectStaticWebAssets">
        <Exec Command="npm ci" WorkingDirectory="$(MSBuildThisFileDirectory)" Condition="!Exists('$(MSBuildThisFileDirectory)node_modules')"/>
        <Exec Command="npm run build" WorkingDirectory="$(MSBuildThisFileDirectory)"/>
        <ItemGroup>
            <Content Remove="wwwroot\index.html;wwwroot\chrome.css"/>
            <Content Include="wwwroot\index.html;wwwroot\chrome.css"/>
        </ItemGroup>
    </Target>

    <!-- Copy the project's own static web assets (everything under wwwroot/: the shell, plus the
         legacy player UI under legacy/) into the AppBundle alongside _framework/ (see
         ../WasmAppBundle.targets). The shell is identical for build and publish, so this runs
         once per invocation, in the build phase. -->
    <Target Name="CopyPlayerAssetsToAppBundle" AfterTargets="Build">
        <ItemGroup>
            <_PlayerAssets Include="@(StaticWebAsset)" Condition="'%(SourceType)' == 'Discovered' and '%(AssetKind)' != 'Publish'"/>
            <!-- Clear out the previous shell first, so a file removed or moved under wwwroot/
                 doesn't linger in the AppBundle (and in export-manifest.json below). -->
            <_StaleShellFiles Include="$(QuestAppBundleDir)**\*" Exclude="$(QuestAppBundleDir)_framework\**"/>
        </ItemGroup>
        <Delete Files="@(_StaleShellFiles)"/>
        <Copy SourceFiles="@(_PlayerAssets)" DestinationFiles="@(_PlayerAssets->'$(QuestAppBundleDir)%(RelativePath)')"/>
        <!-- Manifest of every non-_framework file for AppShell's zip HTML export —
             keeps that list from drifting when assets are added/removed above.
             $(QuestAppBundleDir) ends in a directory separator; trim it before quoting —
             a quoted arg ending "\" is mis-parsed by Windows' argv escaping rules
             (the backslash escapes the closing quote instead of terminating it),
             which broke the windows-latest Electron build (Exec: ENOENT AppBundle"). -->
        <Exec Command="node scripts/write-export-manifest.mjs &quot;$(QuestAppBundleDir.TrimEnd('\').TrimEnd('/'))&quot;" WorkingDirectory="$(MSBuildThisFileDirectory)"/>
    </Target>
</Project>
