<asl version="610">
  <include ref="English.aslx"/>
  <include ref="Core.aslx"/>

  <game name="The Lighthouse">
    <gameid>7d3c1a52-6f0e-4d1b-9f3e-2a5c8e4b1d90</gameid>
    <version>1.0</version>
    <author>Quest Viva</author>
    <subtitle>A short storm at sea</subtitle>
    <start type="script">
      msg ("The storm drove you onto the rocks an hour ago. Now, soaked and shivering, you climb towards the only light on the island.")
    </start>
  </game>

  <object name="shore">
    <inherit name="editor_room"/>
    <alias>sheltered cove</alias>
    <description>Waves break white against black rocks. A path winds up the cliff towards the lighthouse, whose lamp sweeps across the water every few seconds.</description>
    <object name="player">
      <inherit name="editor_object"/>
      <inherit name="editor_player"/>
    </object>
    <object name="driftwood">
      <inherit name="editor_object"/>
      <look>A length of pale, salt-bleached wood, still sturdy.</look>
      <take/>
    </object>
    <exit alias="north" to="cliff_path">
      <inherit name="northdirection"/>
    </exit>
  </object>

  <object name="cliff_path">
    <inherit name="editor_room"/>
    <alias>lighthouse garden</alias>
    <usedefaultprefix type="boolean">false</usedefaultprefix>
    <prefix>the</prefix>
    <description>A walled patch of wind-flattened grass at the top of the cliff. Far below, the sea churns. The lighthouse door stands ajar.</description>
    <object name="gull">
      <inherit name="editor_object"/>
      <inherit name="male"/>
      <alias>gull</alias>
      <look>A herring gull, hunched against the wind, watches you with one yellow eye.</look>
    </object>
    <exit alias="south" to="shore">
      <inherit name="southdirection"/>
    </exit>
    <exit alias="north" to="lamp_room">
      <inherit name="northdirection"/>
    </exit>
  </object>

  <object name="lamp_room">
    <inherit name="editor_room"/>
    <alias>keeper's room</alias>
    <usedefaultprefix type="boolean">false</usedefaultprefix>
    <prefix>the</prefix>
    <description>A cramped room at the foot of the tower. An iron stair spirals up into darkness, and a logbook lies open on the desk.</description>
    <object name="logbook">
      <inherit name="editor_object"/>
      <look>The last entry reads: "Lamp oil low. Gone to the store on the north rocks. Back by nightfall."</look>
      <take/>
    </object>
    <object name="lantern">
      <inherit name="editor_object"/>
      <inherit name="switchable"/>
      <look>A brass storm lantern, half full of oil.</look>
      <take/>
    </object>
    <exit alias="south" to="cliff_path">
      <inherit name="southdirection"/>
    </exit>
  </object>
</asl>
