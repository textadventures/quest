<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <!--
            Nullable is deliberately disabled here. Legacy is frozen compatibility code for Quest 4 and
            earlier games (converted VB6 -> VB.NET -> C#) with little test coverage: the e2e game corpus
            has no .asl/.cas games. Callers already get annotated types through Common's IGame and IPlayer
            interfaces. If a file gets real feature work, opt just that file in with #nullable enable
            rather than enabling it for the whole project.
        -->
        <Nullable>disable</Nullable>
        <RootNamespace>QuestViva.Legacy</RootNamespace>
        <IsAotCompatible>true</IsAotCompatible>
        <PackageId>QuestViva.Legacy</PackageId>
        <LangVersion>default</LangVersion>
        <Description>Quest 4 and earlier backward-compatibility layer for Quest Viva, an open-source text adventure game engine.</Description>
    </PropertyGroup>

    <ItemGroup>
        <EmbeddedResource Include="Libraries\net.lib" />
        <EmbeddedResource Include="Libraries\q3ext.qlb" />
        <EmbeddedResource Include="Libraries\quest.dat" />
        <EmbeddedResource Include="Libraries\standard.lib" />
        <EmbeddedResource Include="Libraries\stdverbs.lib" />
        <EmbeddedResource Include="Libraries\Typelib.qlb" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Common\Common.csproj" />
    </ItemGroup>

    <ItemGroup>
        <SupportedPlatform Include="browser" />
    </ItemGroup>

</Project>
