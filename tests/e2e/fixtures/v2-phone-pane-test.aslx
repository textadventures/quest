<asl version="610">

  <include ref="English.aslx"/>
  <include ref="Core.aslx"/>

  <!-- The "phone" recipe from the panes docs (customise/panes.md, wasmplayer/v2-phone-pane.spec.mjs):
       a pane of the game's own, styled as a phone, showing what the player carries and the exits
       as links, drawn by v2-phone-pane-test.js from QuestUI's list events. Keep both in step with the docs. -->
  <game name="Phone example">
    <showpanes />
    <start type="script">
      AddPane ("phone", "Phone")
      SetPaneVisible ("inventory", false)
      SetPaneVisible ("compass", false)
    </start>
    <stylesheet><![CDATA[
[data-qv-pane="phone"] {
    padding: 14px 10px 28px;
    border-radius: 32px;
    background: #1c1c1e;
    color: #e8f0ff;
}

.phone-screen {
    min-height: 16rem;
    padding: 0.75rem;
    border-radius: 18px;
    background: linear-gradient(#24476b, #0f1f33);
}

.phone-screen h3 {
    margin: 0 0 0.25rem;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.75;
}

.phone-screen ul {
    margin: 0 0 1rem;
    padding: 0;
    list-style: none;
}

.phone-screen a.cmdlink {
    color: #9cd0ff;
}

.phone-exits {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
}

.phone-exits a.cmdlink {
    padding: 0.2rem 0.7rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 15%);
    color: inherit;
    text-decoration: none;
}
]]></stylesheet>
  </game>

  <javascript src="v2-phone-pane-test.js" />

  <object name="hall">
    <inherit name="editor_room" />
    <description>A hall.</description>
    <object name="player">
      <inherit name="defaultplayer" />
    </object>
    <object name="torch">
      <inherit name="editor_object" />
      <take />
    </object>
    <exit alias="north" to="kitchen">
      <inherit name="northdirection" />
    </exit>
  </object>

  <object name="kitchen">
    <inherit name="editor_room" />
    <description>A kitchen.</description>
    <exit alias="south" to="hall">
      <inherit name="southdirection" />
    </exit>
  </object>

</asl>
