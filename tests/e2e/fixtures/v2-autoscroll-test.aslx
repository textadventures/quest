  </command>

  <command name="clearpage">
    <pattern>clearpage</pattern>
    <script><![CDATA[
      ClearScreen
      msg ("<span id='page2mark'>Page 2 begins here.</span> A short page.")
    ]]></script>
  </command>

  <command name="noscroll">
    <pattern>noscroll</pattern>
    <script><![CDATA[
      SetAutoScroll (false)
      msg ("Autoscroll is off.")
    ]]></script>
  </command>

</asl>
