<asl version="610">

  <include ref="English.aslx"/>
  <include ref="Core.aslx"/>

  <!-- Player UI v2's autoscroll (verify-wasmplayer-v2-autoscroll.mjs). shout1..shout6 each print
       more than a screenful, starting from a marker. showframe puts a picture-sized box in the
       picture frame, through the engine's SetPanelContents request. gopage prints a long page,
       waits, clears the screen and prints a short one, and clearpage clears straight away. -->
  <game name="V2AutoscrollTest">
  </game>

  <object name="room">
    <inherit name="editor_room" />
    <object name="player">
      <inherit name="defaultplayer" />
    </object>
  </object>

