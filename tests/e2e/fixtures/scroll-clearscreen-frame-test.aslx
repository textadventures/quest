<asl version="580">
  <include ref="English.aslx" />
  <include ref="Core.aslx" />
  <game name="ScrollClearScreenFrameTest">
  </game>
  <object name="room">
    <object name="player">
    </object>
  </object>
  <command>
    <pattern>showframe</pattern>
    <script><![CDATA[
      JS.setPanelContents ("<div id='testframe' style='height:200px;background:red;'>FRAME</div>")
