<asl version="610">

  <include ref="GamebookCore.aslx"/>

  <!-- The gamebook layout with clearlastpage on (verify-wasmplayer-v2-gamebook.mjs): each page
       replaces the last. Otherwise as v2-gamebook-test.aslx. -->
  <game name="V2GamebookClearTest">
    <clearlastpage />
  </game>

  <object name="Page1">
    <object name="player">
      <inherit name="defaultplayer"/>
    </object>
    <description>This is the first page.</description>
    <picture>cover.png</picture>
    <youtube>7vIi0U4rSX4</youtube>
    <sound>short-beep.wav</sound>
    <options type="simplestringdictionary">Page2 = Turn to page two;Ask = Give your name;Site = Visit the website</options>
  </object>

  <object name="Page2">
    <description>This is page two.</description>
    <options type="simplestringdictionary">Page1 = Back to the first page</options>
  </object>

  <object name="Ask">
    <inherit name="script" />
    <script type="script">
      msg ("What is your name?")
      GetInput () {
        msg ("Hello, " + result + ".")
      }
    </script>
  </object>

  <object name="Site">
    <inherit name="link" />
    <address>https://example.com/</address>
  </object>

</asl>
