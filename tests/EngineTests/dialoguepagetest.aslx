<asl version="600">
  <include ref="English.aslx" />
  <include ref="Core.aslx" />
  <game name="dialoguepagetest"/>

  <object name="hall">
    <inherit name="editor_room" />
    <object name="player">
      <inherit name="defaultplayer" />
    </object>

    <!-- A {page:} link embedded in an ordinary object's description, reached
         from outside any active dialogue - as opposed to a page's own
         auto-rendered options, which the "talk" commands below exercise. -->
    <object name="signpost">
      <inherit name="editor_object" />
      <look>A sign reads: {page:guard_intro:talk to the guard}.</look>
    </object>

    <object name="guard">
      <inherit name="editor_object" />

      <!-- Dialogue pages live under the NPC they belong to - the natural authoring
           structure. visible=false on the type keeps them out of world scoping. -->
      <object name="guard_intro">
        <inherit name="dialoguepage" />
        <description>The guard eyes you suspiciously.</description>
        <options type="simplestringdictionary">guard_weather = Ask about the weather;guard_castle = Ask about the castle;guard_missing = Ask about nothing</options>
      </object>

      <object name="guard_weather">
        <inherit name="dialoguepage" />
        <description>Nice weather today.</description>
        <options type="simplestringdictionary">guard_intro = Back</options>
      </object>

      <object name="guard_castle">
        <inherit name="dialoguepage" />
        <description>The castle is closed.</description>
      </object>

      <object name="guard_scriptredirect">
        <inherit name="dialoguepage" />
        <inherit name="pagescript" />
        <script type="script">
          msg ("redirect script ran")
          GoToPage (guard_weather)
        </script>
      </object>

      <object name="guard_scriptend">
        <inherit name="dialoguepage" />
        <inherit name="pagescript" />
        <script type="script">
          msg ("end script ran")
        </script>
      </object>

      <object name="guard_scripttext">
        <inherit name="dialoguepage" />
        <inherit name="pagescripttext" />
        <description>Text after the script.</description>
        <script type="script">
          msg ("scripttext script ran")
        </script>
        <options type="simplestringdictionary">guard_castle = Go to the castle page</options>
      </object>
    </object>
  </object>

  <command name="cmd_talk">
    <pattern>talk</pattern>
    <script>
      ShowPage (guard_intro, false, false)
    </script>
  </command>

  <command name="cmd_talkcancel">
    <pattern>talkcancel</pattern>
    <script>
      ShowPage (guard_intro, true, false)
    </script>
  </command>

  <command name="cmd_talkturns">
    <pattern>talkturns</pattern>
    <script>
      ShowPage (guard_intro, false, true)
    </script>
  </command>

  <command name="cmd_talkscriptredirect">
    <pattern>talkscriptredirect</pattern>
    <script>
      ShowPage (guard_scriptredirect, false, false)
    </script>
  </command>

  <command name="cmd_talkscriptend">
    <pattern>talkscriptend</pattern>
    <script>
      ShowPage (guard_scriptend, false, false)
    </script>
  </command>

  <command name="cmd_talkscripttext">
    <pattern>talkscripttext</pattern>
    <script>
      ShowPage (guard_scripttext, false, false)
    </script>
  </command>

  <command name="cmd_marker">
    <pattern>marker</pattern>
    <script>
      msg ("marker ran")
    </script>
  </command>

  <turnscript name="ticker">
    <enabled type="boolean">true</enabled>
    <script>
      msg ("tick")
    </script>
  </turnscript>
</asl>
