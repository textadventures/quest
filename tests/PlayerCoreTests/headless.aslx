<asl version="600">
  <include ref="English.aslx" />
  <include ref="Core.aslx" />
  <game name="headless">
    <score type="int">0</score>
    <statusattributes type="stringdictionary">
      <item>
        <key>score</key>
        <value>Score: !</value>
      </item>
    </statusattributes>
    <start type="script">
      msg ("Welcome.")
    </start>
  </game>
  <object name="room">
    <description>A plain room.</description>
    <object name="player">
      <inherit name="defaultplayer" />
    </object>
    <object name="lamp">
      <take />
    </object>
    <exit alias="south" to="hall">
      <inherit name="southdirection" />
    </exit>
  </object>
  <object name="hall" />
  <command name="cmd_score">
    <pattern>testscore</pattern>
    <script>
      game.score = game.score + 5
    </script>
  </command>
  <command name="cmd_nopanes">
    <pattern>testnopanes</pattern>
    <script>
      game.showpanes = false
    </script>
  </command>
  <command name="cmd_nocompass">
    <pattern>testnocompass</pattern>
    <script>
      game.turnoffcompass = true
    </script>
  </command>
  <command name="cmd_wait">
    <pattern>testwait</pattern>
    <script>
      msg ("before wait")
      wait {
        msg ("after wait")
      }
    </script>
  </command>
  <command name="cmd_menu">
    <pattern>testmenu</pattern>
    <script>
      options = NewStringDictionary()
      dictionary add (options, "r", "Red")
      dictionary add (options, "g", "Green")
      show menu ("Pick one", options, true) {
        msg ("chose " + result)
      }
    </script>
  </command>
  <command name="cmd_menu_nocancel">
    <pattern>testmenunocancel</pattern>
    <script>
      options = NewStringDictionary()
      dictionary add (options, "r", "Red")
      dictionary add (options, "g", "Green")
      show menu ("Must pick", options, false) {
        msg ("chose " + result)
      }
    </script>
  </command>
  <command name="cmd_ask">
    <pattern>testask</pattern>
    <script>
      ask ("Sure?") {
        msg ("answer " + result)
      }
    </script>
  </command>
  <command name="cmd_timeout">
    <pattern>testtimeout</pattern>
    <script>
      msg ("set")
      SetTimeout (3) {
        msg ("timeout fired")
      }
    </script>
  </command>
  <command name="cmd_sound">
    <pattern>testsound</pattern>
    <script>
      play sound ("bang.mp3", true, false)
      msg ("after sound")
    </script>
  </command>
  <command name="cmd_clock">
    <pattern>testclock</pattern>
    <script>
      EnableTimer (clock)
    </script>
  </command>
  <command name="cmd_error">
    <pattern>testerror</pattern>
    <script>
      msg ("before error")
      x = nosuchthing.attr
    </script>
  </command>
  <command name="cmd_end">
    <pattern>testend</pattern>
    <script>
      msg ("The end.")
      finish
    </script>
  </command>
  <walkthrough name="passes">
    <steps>
      <![CDATA[
      label:start
      take lamp
      assert:lamp.parent = player
      testmenu
      menu:g
      testask
      answer:yes
      ]]>
    </steps>
  </walkthrough>
  <walkthrough name="failsassert">
    <steps>
      <![CDATA[
      assert:lamp.parent = player
      take lamp
      ]]>
    </steps>
  </walkthrough>
  <walkthrough name="badassert">
    <steps>
      <![CDATA[
      assert:nosuchthing.attr = 1
      ]]>
    </steps>
  </walkthrough>
  <walkthrough name="scripterror">
    <steps>
      <![CDATA[
      testerror
      look
      ]]>
    </steps>
  </walkthrough>
  <walkthrough name="wrongmenukey">
    <steps>
      <![CDATA[
      testmenu
      menu:blue
      ]]>
    </steps>
  </walkthrough>
  <walkthrough name="unansweredmenu">
    <steps>
      <![CDATA[
      testmenu
      look
      ]]>
    </steps>
  </walkthrough>
  <walkthrough name="endsearly">
    <steps>
      <![CDATA[
      testend
      look
      ]]>
    </steps>
  </walkthrough>
  <walkthrough name="delayticks">
    <steps>
      <![CDATA[
      testclock
      delay:5000
      look
      ]]>
    </steps>
  </walkthrough>
  <timer name="clock">
    <interval>10</interval>
    <script>
      msg ("tock")
      DisableTimer (clock)
    </script>
  </timer>
</asl>
