<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>QuestViva.PlayerCoreTests</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1"/>
        <PackageReference Include="MSTest" Version="4.1.0"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\PlayerCore\PlayerCore.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <None Update="test1.asl">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="test1.quest">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="test2.asl">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="test2.quest">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="resources.quest">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <!-- WasmPlayer's page, for PlayerExportTests: the tracked source, which has the same tags as
             the built one (the build splices in icons and stamps asset URLs with ?v=). -->
        <None Include="..\..\src\WasmPlayer\index.html" Link="player-index.html">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Include="..\..\examples\test.asl" Link="quest4.asl">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="functions.aslx">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="check*.aslx">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="headless.aslx">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="test-de.quest">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>
